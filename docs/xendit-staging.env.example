# PREPARATION TEMPLATE ONLY. No actual project/hostname/credentials supplied.
# After explicit staging configuration approval, copy privately to server/.env.staging.
# Never copy production .env, never commit the filled file, and never start it
# before verifying the staging project and clearing conflicting inherited env vars.
NODE_ENV=production
PORT=3001
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Its own reviewed migration/QA gate; do not assume staging baseline is installed.
CUSTOMER_ORDER_CANCELLATION_ENABLED=false

XENDIT_PAYMENTS_ENABLED=false
XENDIT_DEPLOYMENT_VALIDATED=false
XENDIT_ENVIRONMENT=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_ENABLED_METHODS=
XENDIT_CHECKOUT_HOSTS=xen.to
