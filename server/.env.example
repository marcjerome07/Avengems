# Copy this file to .env and fill in the real values. Supabase: Project Settings → API Keys.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_PASSWORD=

# Port the API listens on (the Vite dev proxy expects 3001)
PORT=3001

# Exact browser origin, without a trailing slash. Vite proxies /api to Express.
APP_ORIGIN=http://localhost:5173
# For deployment set NODE_ENV=production and APP_ORIGIN to the real HTTPS origin.
# Google OAuth Client ID/Secret belong in Supabase Auth > Providers > Google,
# not here or in VITE_* variables. See docs/google-login.md.

# Xendit TEST MODE ONLY. Keep both flags false until separate migration approval
# and hosted checkout/webhook QA pass. No provider requests are made at startup.
XENDIT_PAYMENTS_ENABLED=false
XENDIT_DEPLOYMENT_VALIDATED=false
XENDIT_ENVIRONMENT=test
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
# Comma-separated account-enabled methods: gcash,maya,card. Empty disables online.
XENDIT_ENABLED_METHODS=
# Exact HTTPS hosts observed in approved sandbox responses; never a suffix wildcard.
XENDIT_CHECKOUT_HOSTS=xen.to
# Xendit return URLs require HTTPS: use the approved HTTPS public app origin in
# APP_ORIGIN when testing hosted checkout. See docs/xendit-test-payments.md.
